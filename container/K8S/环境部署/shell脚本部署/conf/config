k8s_docker_online='04_kubernetes_docker_install_online.sh'
k8s_docker_offline='04_kubernetes_docker_install_offline.sh'
k8s_harbor_scripts='05_kubernetes_harbor_install_offline.sh'
k8s_ha_online='06_kubernetes_ha_install_online.sh'
k8s_ha_offline='06_kubernetes_ha_install_offline.sh'
k8s_cri_scripts='07_kubernetes_cri_install.sh'
k8s_cluster_scripts='08_kubernetes_cluster_create.sh'
k8s_reset_scripts='09_kubernetes_cluster_reset.sh'
