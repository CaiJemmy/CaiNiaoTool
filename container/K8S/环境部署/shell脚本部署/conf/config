# 软件名称
# [softs]
centos_expect='expect-5.45-14.el7_1.x86_64.rpm'
ubuntu_expect='expect_5.45.4-2build1_amd64.deb'

# 私有仓库属性
# [register]
harbor_user='shuji'
harbor_passwd='A12345678a'
harbor_version='v2.15.2'
harbor_softs="harbor-offline-installer-${harbor_version}.tgz"
harbor_repo='https://github.com/goharbor/harbor/releases/download'
harbor_url="${harbor_repo}/${harbor_version}/${harbor_softs}"

# docker-compose
# [docker-compose]
compose_version='v2.4.0'
compose_softs="docker-compose-linux-x86_64"
compose_repo='https://github.com/docker/compose/releases/download'
compose_url="${compose_repo}/${compose_version}/${compose_softs}"

# docker容器引擎
# [docker]
docker_version='23.0.0'
docker_softs="docker-${docker_version}.tgz"
docker_repo='https://download.docker.com/linux/static/stable/x86_64/'
docker_url="${docker_repo}/${docker_softs}"

# 高可用环境
# [ha]
has_ha="false"
kubernetes_vip='10.0.0.200'
kubernetes_port='6443'
haproxy_status_port='9999'

keepalived_dir='/etc/keepalived'
haproxy_dir='/etc/haproxy'
keepalived_conf='keepalived.conf'
haproxy_conf='haproxy.cfg'
keepalived_check='check_haproxy.sh'

# kubernetes配置
# [kubernetes]
# is_online="true"
k8s_version='1.26.1'
# k8s_softs_dir="${softs_dir}/k8s-centos"
centos_repo_file='/etc/yum.repos.d/kubernetes.repo'
ubuntu_repo_file='/etc/apt/sources.list.d/kubernetes.list'
harbor_repo='google_containers'
harbor_mirror='kubernetes-register.superops.com'
ali_mirror="registry.aliyuncs.com/${harbor_repo}"
init_msg='/tmp/msg.txt'
cri_option='--cri-socket unix:///var/run/cri-dockerd.sock'
